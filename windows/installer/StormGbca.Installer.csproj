<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\..\assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StormInstaller</AssemblyName>
    <AssemblyTitle>STORM GBCA</AssemblyTitle>
    <Title>STORM GBCA</Title>
    <RootNamespace>StormGbca.Installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>STORM GBCA</Product>
    <Company>STORM TEAM</Company>
    <Copyright>Copyright (c) 2026 STORM TEAM. All rights reserved.</Copyright>
    <Description>STORM GBCA</Description>
    <NoWarn>$(NoWarn);WFO1000;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Files\STORM_GBCA_$(Version)_Windows.zip" Link="Payload.zip" Condition="Exists('..\..\Files\STORM_GBCA_$(Version)_Windows.zip')" />
    <EmbeddedResource Include="..\..\releases\STORM_GBCA_$(Version)_Windows.zip" Link="Payload.zip" Condition="!Exists('..\..\Files\STORM_GBCA_$(Version)_Windows.zip') and Exists('..\..\releases\STORM_GBCA_$(Version)_Windows.zip')" />
    <EmbeddedResource Include="Payload\Payload.zip" Link="Payload.zip" Condition="!Exists('..\..\Files\STORM_GBCA_$(Version)_Windows.zip') and !Exists('..\..\releases\STORM_GBCA_$(Version)_Windows.zip') and Exists('Payload\Payload.zip')" />
    <EmbeddedResource Include="..\..\assets\AppIcon.ico" Link="app.ico" />
    <EmbeddedResource Include="$(STORM_CERT_PATH)" Link="STORM_CERTIFICATE.cer" Condition="'$(STORM_CERT_PATH)' != '' and Exists('$(STORM_CERT_PATH)')" />
    <EmbeddedResource Include="STORM_Certificate.cer" Link="STORM_CERTIFICATE.cer" Condition="('$(STORM_CERT_PATH)' == '' or !Exists('$(STORM_CERT_PATH)')) and Exists('STORM_Certificate.cer')" />
    <EmbeddedResource Include="..\..\Files\STORM_Certificate.cer" Link="STORM_CERTIFICATE.cer" Condition="('$(STORM_CERT_PATH)' == '' or !Exists('$(STORM_CERT_PATH)')) and !Exists('STORM_Certificate.cer') and Exists('..\..\Files\STORM_Certificate.cer')" />
  </ItemGroup>

</Project>
